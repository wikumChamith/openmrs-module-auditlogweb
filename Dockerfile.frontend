# O3 frontend with @openmrs/esm-audit-log-app added to the standard RefApp SPA.
FROM --platform=$BUILDPLATFORM node:24-alpine AS build-spa

RUN npm install --legacy-peer-deps --global openmrs@next

# Placed after the CLI install on purpose: CACHE_BUST re-runs only the layers
# below, re-resolving the distro config and the "next" module versions while
# keeping the openmrs CLI layer cached.
ARG CACHE_BUST

# Derive the module list from the distro at build time instead of vendoring a
# copy that would drift silently as the distro adds or removes apps.
ADD https://raw.githubusercontent.com/openmrs/openmrs-distro-referenceapplication/main/frontend/spa-assemble-config.json /app/distro-config.json
WORKDIR /app
RUN node -e "const c=require('./distro-config.json'); c.frontendModules['@openmrs/esm-audit-log-app']='next'; require('fs').writeFileSync('spa-assemble-config.json', JSON.stringify(c,null,2))"

RUN openmrs assemble --mode config --config spa-assemble-config.json --target dist

# Use the official O3 frontend image as the base — it has the correct
# index.html (with SPA bootstrap), nginx config, and env var substitution.
# Note the app shell comes from the base image while modules resolve at build
# time, so the two can drift between base-image and module releases.
FROM openmrs/openmrs-reference-application-3-frontend:nightly
# Drop the base image's app bundles first (the shell, fonts, and config files
# live at the html root and survive): the overlay below brings its own set,
# and stale copies of distro-removed apps would otherwise linger on disk.
RUN rm -rf /usr/share/nginx/html/openmrs-esm-*
COPY --from=build-spa /app/dist /usr/share/nginx/html
